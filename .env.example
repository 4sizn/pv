# The signaling process reads environment variables. Load them in your shell before cargo run.
# No credentials are committed; generate a local secret with: openssl rand -hex 32
TURN_SHARED_SECRET=
# Enable only after verifying relay reachability and Docker/NAT address mapping (infra/README.md).
# TURN_URLS=turn:your-own-host:3478?transport=udp,turn:your-own-host:3478?transport=tcp
# STUN_URLS=stun:your-own-host:3478
