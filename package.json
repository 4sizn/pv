{
  "name": "parentview-next",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "dev:server": "cargo run -p parentview-signaling",
    "dev:desktop": "bun run --cwd apps/desktop tauri dev",
    "test": "bun test packages scripts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:architecture": "bun scripts/check-architecture.ts",
    "build:sdk": "bun run --cwd packages/media-sdk build",
    "build:web": "bun run --cwd apps/desktop build",
    "check": "bun run check:architecture && bun run typecheck && bun run lint && bun test packages scripts",
    "test:rust": "cargo test -p parentview-signaling"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.1.13",
    "typescript": "5.9.3",
    "@playwright/test": "^1.58.0"
  },
  "dependencies": { "rxjs": "7.8.2" }
}
